# ============================================================
# sarDPI — variables d'environnement (copier en .env.local)
# Aucun service cloud obligatoire : tout peut tourner en local.
# ============================================================

# --- Base applicative ---
NODE_ENV=development
PORT=3000
# URL publique utilisée dans les QR codes / liens de vérification / e-mails
APP_URL=http://localhost:3000
# Racine "métier" (locales/, themes/, country-profiles/, data/, storage/) — par défaut : racine du monorepo
# SARDPI_ROOT=/var/lib/sardpi

# --- Sources de données (DATA_ADAPTER: mysql | postgres | json | memory) ---
# json = mode démo/hors-ligne/mono-poste UNIQUEMENT (compteurs émulés, pas de multi-processus)
DATA_ADAPTER=json
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sardpi
MYSQL_PASSWORD=
MYSQL_DATABASE=sardpi
MYSQL_POOL_MAX=10
POSTGRES_URL=postgres://sardpi@127.0.0.1:5432/sardpi
POSTGRES_POOL_MAX=10

# --- Sécurité ---
# À générer : openssl rand -hex 32 (au moins 32 octets). Utilisé pour JWT + tokens signés.
AUTH_SECRET=
# Clé(s) de chiffrement AES-256-GCM des champs sensibles (hex 64). Format rotation : KEY_ID:KEY[,KEY_ID:KEY]
ENC_KEYS=1:
# Durée de vie de l'access token
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# CSRF double-submit
CSRF_COOKIE=sardpi_csrf
# Rate limit global (requêtes / minute / ip) — l'anti brute-force du login est progressif et séparé
RATE_LIMIT_RPM=240

# --- E-mails (SMTP optionnel ; sinon file "outbox" consultable dans l'app) ---
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Clinique Demo <no-reply@clinic.dz>"

# --- Captcha (none | internal | turnstile | hcaptcha | recaptcha) ---
CAPTCHA_PROVIDER=internal
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
RECAPTCHA_SITEKEY=
RECAPTCHA_SECRET=

# --- PDF ---
# Si vide : rendu PDF via navigateur (page d'impression) + Puppeteer si installé (npm run install:pdf)
PUPPETEER_EXECUTABLE_PATH=
PDF_FORMAT=A4

# --- Stockage fichiers (disk par défaut ; s3/MinIO futur via StorageAdapter) ---
STORAGE_DRIVER=disk
STORAGE_DIR=storage
MAX_UPLOAD_MB=20

# --- Cache serveur (sans Redis — lru-cache + table cache_versions) ---
CACHE_TTL_REF=300
CACHE_VERSION_POLL_MS=2000

# --- Jobs (file en base, sans Redis) ---
JOB_POLL_MS=1500
JOB_WORKERS=2

# --- PAYS / DEVISES ---
COUNTRY_PROFILE=DZ
DEFAULT_LOCALE=fr
TIMEZONE=Africa/Algiers

# --- Licence (mode dev : ignorée si vide) ---
LICENSE_KEY=
